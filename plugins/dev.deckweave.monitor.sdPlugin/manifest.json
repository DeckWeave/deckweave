{
  "Name": "System Monitor",
  "Version": "0.1.0",
  "SDKVersion": 2,
  "CodePath": "plugin.mjs",
  "PropertyInspectorPath": "settings.html",
  "DeckWeave": {
    "RequiredFiles": ["bin/deckweave-system.exe"]
  },
  "Actions": [
    {
      "UUID": "dev.deckweave.monitor.cpu",
      "Name": "CPU",
      "Controllers": ["Keypad", "Encoder", "Panel"],
      "Encoder": {
        "layout": "$A0"
      }
    },
    {
      "UUID": "dev.deckweave.monitor.memory",
      "Name": "Memory",
      "Controllers": ["Keypad", "Encoder", "Panel"],
      "Encoder": {
        "layout": "$A0"
      }
    },
    {
      "UUID": "dev.deckweave.monitor.gpu",
      "Name": "GPU busiest engine",
      "Controllers": ["Keypad", "Encoder", "Panel"],
      "Encoder": { "layout": "$A0" }
    },
    {
      "UUID": "dev.deckweave.monitor.gpu-memory",
      "Name": "Dedicated GPU memory",
      "Controllers": ["Keypad", "Encoder", "Panel"],
      "Encoder": { "layout": "$A0" }
    },
    {
      "UUID": "dev.deckweave.monitor.uptime",
      "Name": "Uptime",
      "Controllers": ["Keypad", "Encoder", "Panel"],
      "Encoder": {
        "layout": "$A0"
      }
    }
  ],
  "UUID": "dev.deckweave.monitor",
  "Author": "DeckWeave contributors"
}
