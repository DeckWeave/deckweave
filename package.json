{
  "name": "deckweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @deckweave/desktop",
    "tauri": "npm run tauri --workspace @deckweave/desktop --",
    "dev:web": "vite --config apps/desktop/vite.config.ts",
    "build:web": "vite build --config apps/desktop/vite.config.ts",
    "check:ui": "svelte-check --tsconfig apps/desktop/tsconfig.json",
    "build": "npm run build --workspace @deckweave/desktop",
    "test:core": "cargo test -p deckweave-core --locked",
    "check:format": "prettier --check \"apps/desktop/src/**/*.{svelte,ts,css}\" apps/desktop/vite.config.ts apps/desktop/svelte.config.js apps/desktop/tsconfig.json package.json scripts/*.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "check": "npm run check:ui && npm run check:format && npm run build:web && npm run check:rust && npm run test:weather && npm run test:plugins && npm run test:services && npm run test:workspace && npm run check:docs",
    "test:weather": "node --test scripts/tests/weather.test.mjs",
    "test:services": "node --test scripts/tests/host-services.test.mjs",
    "test:plugins": "node --test scripts/tests/starter-plugins.test.mjs scripts/tests/static-color-coverage.test.mjs scripts/tests/depth-observation.test.mjs scripts/tests/lighting-ui.test.mjs scripts/tests/provider-edit-queue.test.mjs scripts/tests/keyboard-assignments.test.mjs scripts/tests/library-interactions.test.mjs scripts/tests/appearance-composition.test.mjs plugins/dev.deckweave.audio.sdPlugin/audio.test.mjs",
    "test:workspace": "node --test scripts/tests/personal-workspace.test.mjs plugins/dev.deckweave.workspace.sdPlugin/workspace.test.mjs plugins/dev.deckweave.clock.sdPlugin/clock.test.mjs plugins/dev.deckweave.monitor.sdPlugin/monitor.test.mjs plugins/dev.deckweave.focus.sdPlugin/focus.test.mjs integrations/vscode/companion.test.cjs",
    "prepare:workspace": "node scripts/prepare-workspace.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "~6.0.0",
    "vite": "8.3.4"
  }
}
